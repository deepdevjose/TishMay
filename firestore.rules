rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- FUNCIÓN DE ADMIN MEJORADA ---
    // Verifica si es admin por correo específico (Super Admin)
    // O si tiene el rol de admin en su documento de usuario (Administradores delegados)
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == "deepdevjose@itsoeh.edu.mx" ||
        (exists(/databases/$(database)/documents/clientes/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/clientes/$(request.auth.uid)).data.role == "admin")
      );
    }

    // Reglas para Usuarios (Clientes)
    match /clientes/{userId} {
      allow read: if request.auth != null; // Permitir lectura para mostrar nombres en citas
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Reglas para Citas
    match /citas/{citaId} {
      allow read: if request.auth != null;

      // Crear: Solo si la cita es para el usuario autenticado
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;

      // Actualizar/Borrar: El dueño de la cita O un Administrador
      allow update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Colección de administradores (solo lectura explícita si existiera)
    match /administradores/{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
